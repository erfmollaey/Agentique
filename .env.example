# Copy to .env and fill in real values. Never commit .env.
# .env is excluded by .gitignore.

# --- Telegram ---
# From @BotFather via /newbot or /token
BOT_TOKEN=

# --- AI provider (Groq, OpenAI-compatible) ---
# From the provider dashboard. Must match LLM_BASE_URL: a key only authenticates
# against the endpoint that issued it.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Selects the provider implementation. "openai_compatible" covers every
# OpenAI-compatible endpoint (Groq, DeepSeek, OpenRouter, a local server).
LLM_PROVIDER=openai_compatible
# Optional bounded fallback chain, tried in order and only for retryable
# failures. Comma-separated; empty disables it.
# LLM_FALLBACK_MODELS=llama-3.1-8b-instant
# LLM_FALLBACK_MAX_ATTEMPTS=1

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL (Phase 2) ---
# Required. The chat flow cannot run without it, so a missing value stops the
# process at startup instead of failing on the first message.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/research_db
# Credentials the docker-compose postgres service bootstraps with. It has no
# defaults, so these must be set for `make up` to start the database.
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=research_db

# --- Test database ---
# The suite may only touch a database whose name ends in "_test"; anything else
# is refused rather than truncated. Create it once with:
#   createdb research_db_test
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/research_db_test

# --- Web search (Phase 3 P3.2) ---
# The Research Engine's search provider is selected here and normalized behind
# app.domain.research.ports.SearchProvider, so this value is reversible: adding
# another provider is a new adapter plus a branch in
# app.infrastructure.search.create_search_provider, not a change to research
# logic. The measured selection record is docs/audits/PHASE-03_RESEARCH_ENGINE_AUDIT.md § K.
SEARCH_PROVIDER=tavily
# API key from the provider dashboard (Tavily: tvly-…; Brave: a subscription
# token). Optional: nothing searches yet, so the process starts without it.
# When the selected provider has no key, create_search_provider refuses to build
# rather than making unauthenticated requests. Never logged, never in a URL.
SEARCH_API_KEY=
# Results requested per query, bounded at 20. Also the per-query cost lever.
SEARCH_MAX_RESULTS=5
# Client-side deadline for one provider call, in seconds.
SEARCH_TIMEOUT_SECONDS=15.0
# Optional language/market hints for queries that carry none. Empty means the
# user's own question decides, rather than a default bias.
SEARCH_LANGUAGE=
SEARCH_REGION=
# off | moderate | strict. "strict" by default: queries come from arbitrary
# public-chat users.
SEARCH_SAFE_SEARCH=strict

# --- Deduplication and ranking (Phase 3 P3.5) --------------------------------
# Identity rules for collapsing candidate sources. Both default on; each turning
# one off is a deliberate loss of recall, not a performance knob.
#   DEDUP_GROUP_BY_URL     equal canonical URLs are one source. This is the only
#                          rule that still works when extraction failed.
#   DEDUP_GROUP_BY_CONTENT equal extracted-content fingerprints are one source.
#                          This is the only rule that catches syndicated copies at
#                          different URLs. Safe from the boilerplate problem because
#                          it compares P3.4's extracted main content, never the raw
#                          page, so two distinct articles sharing a nav menu are
#                          not collapsed.
DEDUP_GROUP_BY_URL=true
DEDUP_GROUP_BY_CONTENT=true
# Minimum extraction quality a source must reach to be kept. Below it the source
# is recorded as excluded with a reason and kept in the output; it is never
# silently dropped, so a later stage can still count and explain it.
# The scoring weights themselves are NOT configurable: they are named constants
# in app/domain/research/dedup.py, because an unmeasured weight would make an
# ordering unexplainable while looking deliberate.
RANKING_MIN_QUALITY=0.10

# --- Research execution (Phase 3 P3.9-D; AD-047) -----------------------------
# How many candidate sources one research run fetches and how many it keeps for
# the evidence stage. Both are the same bound, because they are the same cost
# decision: a fetch costs up to FETCH_TOTAL_TIMEOUT_SECONDS of wall clock, and
# every source kept costs 1 + CLAIM_MAX_WINDOWS model calls.
#
# The default of 5 equals SEARCH_MAX_RESULTS, the per-query bound P3.2 already
# justified, so a run's work stays inside "what one search step offers" however
# many steps its plan contains. It is NOT a claim that 5 sources answer a question
# well or that a run of 5 finishes inside any deadline: no run has ever executed
# here, so the value requires measurement before production confidence.
# Audit § B5-P2 and § S.7 record exactly what is missing.
RESEARCH_MAX_SOURCES=5

# Cooperative deadline for one research run, in seconds. **Deliberately empty.**
#
# P3.9-C resolved the deadline *mechanism* (AD-045: a cooperative, in-coroutine
# deadline checked at stage boundaries, with Celery's soft limit as a backstop
# only) and left its *number* BLOCKED, because no stage's wall-clock duration has
# ever been measured and no credentialed end-to-end run has executed.
#
# Leaving this empty means a run has no cooperative deadline. That is the honest
# state, not a defect: the run is still bounded by SEARCH_TIMEOUT_SECONDS,
# FETCH_TOTAL_TIMEOUT_SECONDS, the LLM timeout, RESEARCH_MAX_SOURCES, and Celery's
# own limits. Do not fill this in with a figure that has not been measured — set it
# after the first measured run, not before.
RESEARCH_DEADLINE_SECONDS=

# --- Fetch DNS resolution (Phase 3, P3.3) ----------------------------------
# How the fetch boundary turns a hostname into addresses to validate.
#
# "system"  — the platform getaddrinfo. The default, and correct wherever the
#             host's resolver answers honestly.
# "doh"     — resolve through DNS-over-HTTPS instead.
#
# Why "doh" exists: some host networks rewrite every outbound UDP/53 answer into
# 198.18.0.0/15 (RFC 2544 benchmarking — Tailscale MagicDNS and comparable
# fake-IP pools do this, including for names that do not exist). The SSRF
# boundary refuses those addresses, correctly, and every fetch then fails with
# FetchBlockedDestinationError for reasons that look like an outage. Setting the
# container's DNS servers does NOT fix this — a raw query to 1.1.1.1:53 from such
# a container still comes back fake, because the rewrite is on the network path.
# HTTPS is not rewritten, so DoH answers are real.
#
# This changes only where an answer comes from, never whether it is allowed: the
# address policy, the blocklists, and "every answer must pass" are identical in
# both modes, and a DoH answer for a private host is refused exactly as a system
# answer would be. There is no mode that relaxes the policy.
FETCH_DNS_MODE=system
# Comma-separated list of RFC 8484 endpoints, tried in order. Only used when
# FETCH_DNS_MODE=doh. Each is tried only when the previous one could not be
# reached or understood (transport failure, non-200, malformed answer); an
# endpoint that answers — including an answer of "no records" — is used as-is,
# because which provider answered is then something you can reason about.
# Replace these with a resolver you trust or run.
FETCH_DNS_SERVERS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query
# Bound on one DNS-over-HTTPS round trip, per attempt. Separate from the fetch
# timeout on purpose: a resolver that hangs must not consume a fetch's budget.
FETCH_DOH_TIMEOUT_SECONDS=5.0

# --- Research planning (Phase 3 P3.6) ---------------------------------------
# Every planning limit is a cost or latency bound: each step becomes at least one
# provider call downstream. `app/domain/research/planning.py` additionally enforces
# a hard structural ceiling on steps that configuration cannot raise.
# Steps allowed in one plan. Rejected above this before any model is called.
PLAN_MAX_STEPS=6
# Bound on the research question, so the prompt cannot grow without limit.
PLAN_MAX_QUESTION_CHARS=2000
# Output bound for the planning call. Separate from LLM_MAX_TOKENS because a plan
# is structurally longer than a chat reply.
PLAN_MAX_TOKENS=1500

# --- Per-source summarization + claim extraction (Phase 3 P3.7) ---------------
# Cost bounds for the per-source stage. One summary call plus at most
# CLAIM_MAX_WINDOWS extraction calls per selected source. Content bounds (summary
# length, statement length, quote length, minimum quote length) are structural
# constants in app/domain/research/evidence.py, not configuration.
# Input budget for the summary call, in estimated tokens. Windows hold whole
# passages, and anything that does not fit is reported as uncovered rather than
# quietly dropped.
SUMMARY_MAX_INPUT_TOKENS=4000
# Output bound for the summary call.
SUMMARY_MAX_TOKENS=800
# Input budget for ONE claim-extraction call, in estimated tokens.
CLAIM_MAX_INPUT_TOKENS=4000
# Output bound for the claim-extraction call.
CLAIM_MAX_TOKENS=1200
# Ceiling on claim-extraction calls per source. Passages beyond this are counted
# as uncovered evidence, never skipped silently.
CLAIM_MAX_WINDOWS=4
# Claims requested per call.
CLAIM_MAX_CLAIMS=8

# --- Cross-source synthesis + citations (Phase 3 P3.8) ----------------------
# One provider call per run, unlike P3.7's 1 + windows per source. What is offered
# to the model is "verified claim + verified quote + source metadata", never whole
# fetched pages. Evidence is offered highest-ranked first; anything that does not fit
# is counted and reported on the result rather than silently dropped, so a truncated
# synthesis is distinguishable from a complete one.
# Input budget for the synthesis call, in estimated tokens.
SYNTHESIS_MAX_INPUT_TOKENS=8000
# Evidence items offered to one call. The structural ceiling is
# MAX_EVIDENCE_CEILING in app/domain/research/synthesis.py.
SYNTHESIS_MAX_EVIDENCE=30
# Sections requested per call. Each section is a unit of citation completeness: it
# must name at least one citation that resolves to evidence of this run.
SYNTHESIS_MAX_SECTIONS=6
# Output bound for the synthesis call.
SYNTHESIS_MAX_TOKENS=2000
