# Copy to .env and fill in real values. Never commit .env.
# .env is excluded by .gitignore.

# --- Telegram ---
# From @BotFather via /newbot or /token
BOT_TOKEN=

# --- AI provider (Groq, OpenAI-compatible) ---
# From the provider dashboard. Must match the base_url in
# app/agents/supervisor.py — a DeepSeek-format key does not work
# against an OpenRouter endpoint, and vice versa.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL ---
# Not used yet. No database code exists (see docs/ARCHITECTURE.md M-2).
# Will be wired up in Phase 2.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/research_db
