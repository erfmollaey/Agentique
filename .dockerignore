# Build context exclusions.
# Keeps the image small and prevents local state leaking into a build.

.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Secrets must never enter an image layer.
.env
.env.*
!.env.example

# Tests and docs are not needed at runtime.
tests
docs
.agents
*.md
!README.md

.DS_Store
.idea
.vscode
